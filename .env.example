# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# Client (browser) — these ARE shipped in the production bundle.
# Vite inlines every VITE_* value at build time, so anyone can read them in
# devtools. Only ever put public values here. The anon key is public by design;
# what protects the data is RLS (supabase/schema.sql), not hiding this key.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Local scripts only — NEVER prefix these with VITE_, or they get bundled and
# published. Used by `npm run enrich` (scripts/enrich.mjs), which runs on your
# machine and is never deployed.
# ---------------------------------------------------------------------------

# TMDB API read access token (Settings -> API -> API Read Access Token).
TMDB_TOKEN=your-tmdb-read-access-token

# Supabase service_role key (Settings -> API). Bypasses RLS, so the enrich
# script can write film_metadata without signing in. Treat as a root password:
# keep it local, never commit it, never send it to the browser.
SUPABASE_SERVICE_KEY=your-service-role-key

# Same project URL as above, without the VITE_ prefix (scripts don't see VITE_*).
SUPABASE_URL=https://your-project.supabase.co
